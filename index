};
const keys=Object.keys(D).sort((a,b)=>b.length-a.length).map(k=>k.replace(/[-]/g,'\\-'));
const RX=new RegExp('(?<![a-z])('+keys.join('|')+')(?:nya|ku|mu)?(?![a-z])','g');
const ADJ='busy|tired|happy|sad|sick|excited|late|hungry|sleepy|annoyed|confused|insane|free|nervous|shook|down|so cool|pretty|cute|good';
const cop={i:'i’m',you:'you’re',we:'we’re',they:'they’re'};
const pick=a=>a[Math.floor(Math.random()*a.length)];
const cap=s=>s.replace(/(^\s*|[.!?]\s+|\n\s*)([a-z])/g,(m,a,b)=>a+b.toUpperCase()).replace(/\bi\b/g,'I');
function base(t){
  let s=t.toLowerCase().replace(RX,(m,k)=>D[k]);
  s=s.replace(/(\S+) ~B/g,'so $1').replace(/~B/g,'so').replace(/[ \t]+/g,' ').replace(/ ([,.!?])/g,'$1').trim();
  s=s.replace(new RegExp('\\b(i|you|we|they)\\s+(so\\s+)?('+ADJ+'|[a-z]+ing)\\b','g'),(m,p,so,a)=>cop[p]+' '+(so||'')+a);
  return s;
}
const TONE={
chill(s){
  s=s.replace(/thank you so much/g,'tysm').replace(/thank you/g,'ty').replace(/\bso\b/g,()=>Math.random()<.5?'soo':'so')
     .replace(/\bi am\b/g,'i’m').replace(/[.]+$/,'');
  if(/\?$/.test(s))return s+pick(['',' 🥺',' 😭']);
  if(/!$/.test(s))return s+pick(['',' ✨',' 💗']);
  return s+pick(['',' 🥹',' 💗',' lol',' 😭',' fr',' ✨']);
},
short(s){
  s=s.replace(/\b(just|really|so|too|definitely|fr)\b\s*/g,'').replace(/\b(btw|tbh|imo|omg)\b,?\s*/g,'')
     .replace(/\brn\b/g,'now').replace(/\btmrw\b/g,'tomorrow').replace(/\bbc\b/g,'because').replace(/\bpls\b/g,'please')
     .replace(/\btysm\b/g,'thanks').replace(/\bthank you\b/g,'thanks').replace(/\bwanna\b/g,'want to').replace(/\bidk\b/g,'I don’t know')
     .replace(/\s+/g,' ').trim();
  s=cap(s);return /[.!?]$/.test(s)?s:s+'.';
},
polite(s){
  s=s.replace(/\brn\b/g,'right now').replace(/\btmrw\b/g,'tomorrow').replace(/\bbc\b/g,'because').replace(/\bpls\b/g,'please')
     .replace(/\btysm\b/g,'thank you so much').replace(/\bbtw\b/g,'by the way').replace(/\bidk\b/g,'I’m not sure')
     .replace(/\bwanna\b/g,'would love to').replace(/\bwant to\b/g,'would like to').replace(/\bimo\b/g,'I think').replace(/\btbh\b/g,'honestly');
  s=cap(s);if(!/^(hi|hello|hey)\b/i.test(s))s='Hi! '+s;
  const ask=/please|help|send|can you/i.test(s);
  if(!/[.!?]$/.test(s))s+='.';
  return ask?s+' '+pick(['Thank you so much! 💕','Thanks a lot! 🌸','Thank you! 😊']):s;
}};
let tone='chill';
$('tones').onclick=e=>{const t=e.target.dataset.tone;if(!t)return;tone=t;
  [...$('tones').children].forEach(b=>b.classList.toggle('on',b.dataset.tone===t))};
$('rgo').onclick=()=>{
  const lines=$('rin').value.split('\n').filter(l=>l.trim());
  $('rout').value=lines.map(l=>TONE[tone](base(l))).join('\n');
};
$('rcopy').onclick=async()=>{
  const v=$('rout').value;if(!v)return;
  try{await navigator.clipboard.writeText(v)}catch(_){$('rout').select();document.execCommand('copy')}
  const t=$('tip');t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1400);
};
